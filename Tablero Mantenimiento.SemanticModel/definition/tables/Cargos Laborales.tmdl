	column 'Es Tercerizado'
		dataType: boolean
		lineageTag: 1a08c9ff-77a4-457a-a7be-61c1e3847b7c
		summarizeBy: none
		sourceColumn: Es Tercerizado

		annotation SummarizationSetBy = Automatic

	partition 'Cargos Laborales' = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaCarpeta & "Cargos-Laborales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Renombrado = Table.RenameColumns(Encabezados, {{"N°OT", "N° OT"},{"Blanco", "Técnico"},{"Orden de trabajo", "Descripción de la OT"},{"Tipo de orden de trabajo", "Tipo de Orden de Trabajo"},{"Estado del trabajo", "Estado del Trabajo"},{"Horas de trabajo", "Horas de Trabajo"}}),
				    Tipos = Table.TransformColumnTypes(Renombrado, {{"N° OT", Int64.Type},{"Horas de Trabajo", type number}}),
				    ParsearFechaTexto = (v as any) as nullable datetime =>
				        if v = null or v = "" then null else try DateTime.FromText(Text.From(v), [Format="dd-MM-yyyy HH:mm", Culture="es-AR"]) otherwise null,
				    ConFechas = Table.TransformColumns(Tipos, {{"Fecha Inicio", ParsearFechaTexto, type nullable datetime},{"Fecha Fin", ParsearFechaTexto, type nullable datetime}}),
				    AgregarTercerizado = Table.AddColumn(ConFechas, "Es Tercerizado", each [Compañía] <> null and Text.Trim([Compañía]) <> "Royal Canin", type logical),
				    LimpiarTecnico = Table.TransformColumns(AgregarTercerizado, {{"Técnico", each Text.Trim(Text.From(_)), type text}})
				in
				    LimpiarTecnico

